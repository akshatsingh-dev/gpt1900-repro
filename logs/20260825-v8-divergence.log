        x = a[m][t]['completions'][0]; y = b[m][t]['completions'][0]
        pre.append((len(os.path.commonprefix([x, y])), m, t))
pre.sort()
print('shared opening characters -> shortest:', pre[0][0], 'longest:', pre[-1][0], 'average:', sum(p[0] for p in pre)//len(pre))
n, m, t = pre[-1]
